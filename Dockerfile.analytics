#ARG BASE_IMAGE=ghcr.io/brillouin-imaging/brimview:latest
ARG BASE_IMAGE=brimview:latest
FROM ${BASE_IMAGE}

# Copy your app code
COPY --chown=panel:panel analytics/request_logger_setup.py /app/
COPY --chown=panel:panel analytics/resource_monitor.py /app/

# Toggle Prometheus support for analytics request metrics.
# Set ENABLE_PROMETHEUS=false to skip prometheus_client installation.
ARG ENABLE_PROMETHEUS=false
ARG METRICS_PORT=9100
ENV ENABLE_PROMETHEUS=${ENABLE_PROMETHEUS}
ENV METRICS_PORT=${METRICS_PORT}

# Install optional Python dependency only when Prometheus is enabled.
RUN if [ "$ENABLE_PROMETHEUS" = "true" ] || [ "$ENABLE_PROMETHEUS" = "1" ]; then \
            pip install --no-cache-dir prometheus_client; \
        else \
            echo "Prometheus disabled; skipping prometheus_client installation"; \
        fi

# Expose metrics port metadata.
# If you disable Prometheus for an image, build with METRICS_PORT=0.
EXPOSE $METRICS_PORT

# ENV ADMIN_ENDPOINT exists in the base image

# Start the Panel app
# see https://discourse.bokeh.org/t/understanding-the-allow-websocket-origin-option/10636 for allow-websocket-origin
CMD ["/bin/sh", "-c", "panel serve index.py --index=index \
    --liveness --liveness-endpoint healthz \
    --address 0.0.0.0 --port 5006 --allow-websocket-origin 'brimview.embl.org' \
    --use-xheaders \
    --setup request_logger_setup.py \
    --admin --admin-endpoint \"$ADMIN_ENDPOINT\" --admin-log-level debug \
    --global-loading-spinner \
    --num-procs 1 --num-threads 0 \
    --args from-docker"]
