{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Panel serve",
            "type": "debugpy",
            "request": "launch",
            "module": "panel",
            "args": [
                "serve",
                "${workspaceFolder}/src/index.py",
                "--index=index",
                "--admin"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/BrimView-widgets"
            }
        },
        {
            "name": "Panel serve (with analytics)",
            "type": "debugpy",
            "request": "launch",
            "module": "panel",
            "args": [
                "serve",
                "${workspaceFolder}/src/index.py",
                "--admin",
                "--index=index",
                "--setup", "${workspaceFolder}/analytics/request_logger_setup.py",
                "--use-xheaders",
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/BrimView-widgets",
                "REQUEST_LOG_DB": "${workspaceFolder}/TODELETE/requests.db"
            }
        },
        {
            "name": "Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}